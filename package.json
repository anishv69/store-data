{
  "name": "retail-store-analytics",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run db:generate && next build",
    "vercel-build": "prisma generate && prisma db push && next build",
    "start": "next start",
    "test": "tsx --test tests/aggregations.test.ts tests/apple-store-snapshot.test.ts tests/auth-security.test.ts tests/insurance.test.ts tests/store-geo.test.ts",
    "stores:sync": "node scripts/sync-apple-stores.mjs",
    "stores:english": "node scripts/normalize-apple-stores-english.mjs",
    "db:generate": "cross-env DATABASE_URL=postgresql://retail_demo:retail_demo_password@localhost:5432/retail_analytics?schema=public prisma generate",
    "db:push": "cross-env DATABASE_URL=postgresql://retail_demo:retail_demo_password@localhost:5432/retail_analytics?schema=public prisma db push",
    "db:migrate": "cross-env DATABASE_URL=postgresql://retail_demo:retail_demo_password@localhost:5432/retail_analytics?schema=public prisma migrate dev",
    "db:seed": "cross-env DATABASE_URL=postgresql://retail_demo:retail_demo_password@localhost:5432/retail_analytics?schema=public prisma db seed",
    "db:seed:reset": "cross-env DATABASE_URL=postgresql://retail_demo:retail_demo_password@localhost:5432/retail_analytics?schema=public SEED_RESET=true prisma db seed"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.11.1",
    "bcryptjs": "^3.0.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.525.0",
    "next": "^15.4.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-leaflet": "^5.0.0",
    "recharts": "^3.1.0",
    "transliteration": "^2.6.1",
    "tz-lookup": "^6.1.25"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.11",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "cross-env": "^10.0.0",
    "prisma": "^6.11.1",
    "tailwindcss": "^4.1.11",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
