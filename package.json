{
  "name": "retail-store-analytics",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run db:generate && next build",
    "start": "next start",
    "db:generate": "cross-env DATABASE_URL=postgresql://retail_demo:retail_demo_password@localhost:5432/retail_analytics?schema=public prisma generate",
    "db:push": "cross-env DATABASE_URL=postgresql://retail_demo:retail_demo_password@localhost:5432/retail_analytics?schema=public prisma db push",
    "db:migrate": "cross-env DATABASE_URL=postgresql://retail_demo:retail_demo_password@localhost:5432/retail_analytics?schema=public prisma migrate dev",
    "db:seed": "cross-env DATABASE_URL=postgresql://retail_demo:retail_demo_password@localhost:5432/retail_analytics?schema=public prisma db seed"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.11.1",
    "bcryptjs": "^3.0.2",
    "lucide-react": "^0.525.0",
    "next": "^15.4.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^3.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.11",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "cross-env": "^10.0.0",
    "prisma": "^6.11.1",
    "tailwindcss": "^4.1.11",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
