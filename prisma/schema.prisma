generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STORE_MANAGER
  REGIONAL_MANAGER
  EXECUTIVE
}

enum InsuranceRequirement {
  STATUTORY
  CONTRACTUAL
  GOVERNANCE
  RISK_MANAGEMENT
}

enum InsuranceFinancing {
  CAPTIVE
  COMMERCIAL
  HYBRID
  STATE_PROGRAM
}

enum InsurancePolicyStatus {
  ACTIVE
  RENEWAL_DUE
  EXPIRED
}

model User {
  id       Int     @id @default(autoincrement())
  name     String
  email    String  @unique
  password String
  role     Role
  storeId  Int?
  region   String?
  store    Store?  @relation(fields: [storeId], references: [id])
}

model Store {
  id            Int           @id @default(autoincrement())
  sourceId      String?
  sourceUrl     String?
  name          String
  streetAddress String?
  postalCode    String?
  phone         String?
  city          String
  state         String
  region        String
  company       String        @default("Apple Inc")
  area          String        @default("Apple North America")
  countryGroup  String        @default("Apple USA")
  stateGroup    String        @default("Apple Michigan")
  market        String        @default("Apple Detroit")
  managerName   String
  country       String?
  countryCode   String?
  continent     String?
  latitude      Decimal?      @db.Decimal(9, 6)
  longitude     Decimal?      @db.Decimal(9, 6)
  timezone      String?
  currency      String?
  isOfficial    Boolean       @default(false)
  createdAt     DateTime      @default(now())
  users         User[]
  inventory     Inventory[]
  transactions  Transaction[]

  @@index([state, city])
  @@index([city])
  @@index([region])
  @@index([continent, country])
  @@index([countryCode])
  @@index([sourceId])
  @@index([isOfficial, continent, country])
}

model Product {
  id           Int           @id @default(autoincrement())
  name         String
  sku          String        @unique
  category     String
  price        Decimal       @db.Decimal(10, 2)
  createdAt    DateTime      @default(now())
  inventory    Inventory[]
  transactions Transaction[]

  @@index([name])
}

model Inventory {
  id        Int      @id @default(autoincrement())
  storeId   Int
  productId Int
  quantity  Int
  updatedAt DateTime @updatedAt
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([storeId, productId])
}

model Transaction {
  id          Int      @id @default(autoincrement())
  storeId     Int
  productId   Int
  quantity    Int
  unitPrice   Decimal  @db.Decimal(10, 2)
  totalAmount Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Restrict)
  product     Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([storeId, createdAt])
  @@index([productId, createdAt])
}

model InsurancePolicy {
  id             Int                   @id @default(autoincrement())
  policyCode     String                @unique
  company        String
  coverageName   String
  category       String
  requirement    InsuranceRequirement
  financing      InsuranceFinancing
  geography      String
  coverageLimit  Decimal               @db.Decimal(15, 2)
  retainedAmount Decimal               @db.Decimal(15, 2)
  annualPremium  Decimal               @db.Decimal(15, 2)
  effectiveDate  DateTime
  expirationDate DateTime
  status         InsurancePolicyStatus
  description    String
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([company, status])
  @@index([category])
  @@index([requirement])
  @@index([expirationDate])
}
